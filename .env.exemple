# =====================================================================
# Variables d'environnement — copier ce fichier en « .env » (ignoré par Git)
# puis remplacer les valeurs. NE JAMAIS committer le fichier .env.
# Les valeurs ci-dessous conviennent au développement local.
# =====================================================================

# --- Base de données PostgreSQL ---------------------------------------
# Noms imposés par l'image officielle postgres, réutilisés par le backend.
POSTGRES_DB=boutique
POSTGRES_USER=boutique
POSTGRES_PASSWORD=boutique-dev
# Hôte vu par le backend (docker-compose le remplace par « postgres »)
BASE_DONNEES_HOTE=localhost
BASE_DONNEES_PORT=5432

# --- Redis ------------------------------------------------------------
REDIS_HOTE=localhost
REDIS_PORT=6379
REDIS_MOT_DE_PASSE=boutique-dev

# --- Site -------------------------------------------------------------
# URL publique (canoniques, e-mails, flux produits)
URL_SITE=http://localhost:4200
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINES=http://localhost:4200

# --- Sécurité (phase 1) -----------------------------------------------
# Clé de signature des jetons d'accès : 32 octets minimum, encodée en Base64.
# Générer : openssl rand -base64 48
# Obligatoire en production. En dev, si elle est vide ou invalide, une clé jetable est générée
# au démarrage (les sessions sont alors perdues à chaque redémarrage).
JWT_SECRET=

# --- Cloudinary (phase 2) ---------------------------------------------
# Format : cloudinary://<cle_api>:<secret_api>@<nom_du_cloud>
CLOUDINARY_URL=cloudinary://cle:secret@nom-du-cloud

# --- E-mails (SMTP) ---------------------------------------------------
# En dev : Mailpit (docker compose --profile dev up -d mailpit), e-mails visibles sur http://localhost:8025
SMTP_HOTE=localhost
SMTP_PORT=1025
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
EMAIL_EXPEDITEUR=Boutique <no-reply@exemple.sn>
# Nom affiché dans les e-mails
NOM_SITE=Boutique informatique

# --- Paiements (phase 4) ----------------------------------------------
PAYDUNYA_CLE_MAITRE=
PAYDUNYA_CLE_PRIVEE=
PAYDUNYA_JETON=
PAYDUNYA_MODE=test

# --- Suivi publicitaire côté serveur (phase 7) ------------------------
# Les identifiants publics (GTM, GA4, pixel) sont gérés dans ParametresSite.
META_CAPI_JETON_ACCES=
META_CAPI_ID_PIXEL=
META_CAPI_CODE_TEST=
META_GRAPH_VERSION=v24.0

# --- Frontend SSR -----------------------------------------------------
# URL de l'API vue par le serveur SSR (docker-compose : http://backend:8080)
API_URL_SERVEUR=http://localhost:8080
# Noms d'hôte acceptés par le serveur SSR (protection SSRF), séparés par des virgules.
# En production : le domaine du site, ex. boutique.sn,www.boutique.sn
NG_ALLOWED_HOSTS=localhost

# --- Données de démonstration (profil « demo » : SPRING_PROFILES_ACTIVE=dev,demo) ---
# Compte SUPER_ADMIN créé au premier démarrage. Sans mot de passe, il n'est pas créé.
# 12 caractères minimum. Ne jamais réutiliser ce mot de passe en production.
DEMO_ADMIN_EMAIL=admin@exemple.sn
DEMO_ADMIN_MOT_DE_PASSE=
