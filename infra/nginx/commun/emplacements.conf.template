# Contenu commun aux serveurs nginx (inclus par infra/nginx/modes/https.conf.template et http.conf.template) :
# résolution DNS, compression, en-têtes de sécurité, en-têtes transmis aux conteneurs et routes.
# Modèle : les ${NGINX_…} sont remplacés au démarrage, comme dans default.conf.template.

# Résolution DNS à chaque expiration (10 s) par le DNS interne de Docker, au lieu d'une seule fois au
# démarrage : quand le backend ou le frontend est recréé (nouvelle IP), nginx le retrouve sans
# redémarrage ni 502. Cela impose des variables dans proxy_pass (et nginx -t ne dépend plus de la
# présence des conteneurs). Contrepartie : pas de bloc upstream, donc pas de connexions keepalive
# vers les conteneurs, négligeable à notre échelle.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;
set $backend  backend:8080;
set $frontend frontend:4000;

# Journaux : format « confidentiel » (jetons masqués, voir default.conf.template). Le journal d'erreurs répète la
# ligne de requête telle quelle (jeton compris) et nginx ne permet pas de la masquer : il ne garde donc que les
# erreurs critiques. Les échecs vers le backend ou le SSR restent visibles dans le journal d'accès (statut 502/504,
# « amont »). Pour déboguer, passer temporairement à « error » en sachant que des jetons peuvent y apparaître.
access_log /var/log/nginx/access.log confidentiel;
error_log /var/log/nginx/error.log crit;

# Corps de requête : 1 Mo partout (JSON de l'API, formulaires). Seules les routes d'envoi de médias du
# back-office acceptent 55 Mo (voir plus bas). Les vidéos vont directement du navigateur à Cloudinary.
client_max_body_size 1m;
server_tokens off;

# --- Compression ----------------------------------------------------
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
# text/javascript : type servi par le serveur SSR (Express) pour les fichiers .js
gzip_types text/plain text/css text/xml application/xml application/rss+xml
           text/javascript application/javascript application/json application/problem+json
           application/ld+json image/svg+xml image/x-icon;

# --- En-têtes de sécurité de base -----------------------------------
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host $host;
# nginx est le point d'entrée public : l'IP du client est celle de la connexion TCP ($remote_addr).
# On ÉCRASE X-Forwarded-For au lieu de l'allonger ($proxy_add_x_forwarded_for recopierait la valeur
# envoyée par le client, qui pourrait alors se faire passer pour n'importe quelle IP et contourner
# la limitation du débit). Voir ADR 0003 §13. Si un CDN est ajouté devant nginx, revoir cette règle
# (module real_ip avec la liste des adresses du CDN).
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;

# --- Backend --------------------------------------------------------
# proxy_pass SANS partie URI après la variable : nginx transmet l'URI d'origine intacte (chemin
# encodé et paramètres). Ne jamais écrire « http://$backend/ » : le chemin serait remplacé par « / ».
location /api/ {
    limit_req zone=api burst=${NGINX_RAFALE_API} nodelay;
    proxy_pass http://$backend;
}

location /api/recherche {
    limit_req zone=recherche burst=${NGINX_RAFALE_RECHERCHE} nodelay;
    proxy_pass http://$backend;
}

# Envois de médias du back-office (authentifiés, rôles vérifiés par le backend) : images groupées,
# 50 Mo côté Spring, marge pour l'encodage multipart.
location ~ ^/api/admin/(produits/[0-9]+/medias|parametres/[a-z-]+|bannieres/images)$ {
    client_max_body_size 55m;
    limit_req zone=api burst=${NGINX_RAFALE_API} nodelay;
    proxy_pass http://$backend;
}

location = /sitemap.xml {
    proxy_pass http://$backend;
}

location ~ ^/sitemap-[a-z0-9-]+\.xml$ {
    proxy_pass http://$backend;
}

location = /robots.txt {
    proxy_pass http://$backend;
}

location /flux/ {
    limit_req zone=api burst=${NGINX_RAFALE_API} nodelay;
    proxy_pass http://$backend;
}

# La supervision n'est jamais exposée publiquement.
location /actuator/ {
    return 404;
}

# --- Suivi d'une commande par son lien, retour de paiement ----------------
# Le jeton (de suivi, ou de retour du prestataire de paiement) est dans l'URL : la page ne doit le transmettre dans aucun en-tête Referer (liens sortants,
# WhatsApp, réseaux). Un add_header dans un location remplace ceux du niveau supérieur : ils sont répétés ici.
location ~ ^/(suivi|commande/retour)/ {
    limit_req zone=pages burst=${NGINX_RAFALE_PAGES} nodelay;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    proxy_pass http://$frontend;
}

# --- Espace client et liens d'e-mail (/compte/…) -------------------------
# Pages privées : jamais mises en cache ni indexées. Les liens d'e-mail (vérification, réinitialisation,
# déverrouillage) portent un jeton dans l'URL : aucun Referer ne doit en sortir (ADR 0003 §12). Cache-Control
# du SSR est remplacé (proxy_hide_header) pour ne pas envoyer deux valeurs ; les add_header du niveau supérieur
# sont répétés (un add_header dans un location remplace les autres).
location ^~ /compte {
    limit_req zone=pages burst=${NGINX_RAFALE_PAGES} nodelay;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    proxy_pass http://$frontend;
}

# --- Administration (/admin/…) -------------------------------------------
# Rendue dans le navigateur seulement. Jamais en cache ni indexée ; le lien d'invitation porte un jeton dans l'URL
# (aucun Referer ne doit en sortir, ADR 0009). add_header du niveau supérieur répétés comme pour /compte.
location ^~ /admin {
    limit_req zone=pages burst=${NGINX_RAFALE_PAGES} nodelay;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    proxy_pass http://$frontend;
}

# --- Pages rendues côté serveur (SSR) et fichiers statiques -------------
# Le serveur SSR (Express) pose lui-même Cache-Control : un an, immuable,
# pour les fichiers JS/CSS à empreinte et les polices.
location / {
    limit_req zone=pages burst=${NGINX_RAFALE_PAGES} nodelay;
    proxy_pass http://$frontend;
}
