# Mode HTTPS : base de la PRODUCTION (voir ADR 0006). Seuls les chemins du certificat changent selon
# l'environnement (NGINX_CERTIFICAT, NGINX_CLE_CERTIFICAT, dossier monté NGINX_DOSSIER_CERTIFICATS) :
# certificat autosigné généré pendant le job Lighthouse, Let's Encrypt en production (phase 9).
# Le certificat et sa clé ne sont jamais commités (infra/certificats/ est ignoré par Git).

# Port 80 : uniquement la redirection permanente vers HTTPS (et, en phase 9, le défi Let's Encrypt).
server {
    listen 80;
    server_name _;
    server_tokens off;

    # Défi HTTP-01 de Let's Encrypt (phase 9) : fichiers déposés par certbot, servis en HTTP simple
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     ${NGINX_CERTIFICAT};
    ssl_certificate_key ${NGINX_CLE_CERTIFICAT};

    # Profil « intermediate » de Mozilla : TLS 1.3 et TLS 1.2 avec des suites AEAD à confidentialité
    # persistante. TLS 1.2 reste nécessaire pour les Android d'avant la version 10, encore nombreux au
    # Sénégal. Pas de suites DHE (elles exigeraient un fichier dhparam) ; pas d'agrafage OCSP
    # (Let's Encrypt a arrêté OCSP en 2025).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS (ADR 0003, en-têtes de phase 9) : le navigateur n'utilise plus que HTTPS pendant un an.
    # « preload » seulement après vérification de tous les sous-domaines.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/conf.d/commun/emplacements.conf;
}
