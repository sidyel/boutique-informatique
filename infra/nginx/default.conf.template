# Frontal nginx : l'API, le sitemap, robots.txt et les flux produits vont au backend,
# tout le reste au serveur de rendu Angular (SSR).
#
# Organisation (voir ADR 0006) :
#  - ce fichier : réglages globaux (limitation du débit) puis inclusion des serveurs du mode choisi ;
#  - modes/https.conf.template : base de la PRODUCTION (HTTPS, HTTP/2, redirection 80 → 443), aussi
#    utilisée par le workflow Lighthouse avec un certificat autosigné ;
#  - modes/http.conf.template : HTTP simple sur le port 80, pour le développement local uniquement ;
#  - commun/emplacements.conf.template : routes et en-têtes, identiques dans les deux modes.
# Le mode est choisi par NGINX_MODE (docker-compose.yml : https ; docker-compose.dev.yml : http par défaut).
# Brotli et CSP complète : phase 9.
#
# Modèle de l'image nginx officielle : au démarrage, les ${NGINX_…} sont remplacés par les variables
# d'environnement du conteneur (valeurs par défaut dans infra/docker-compose.yml). Seules les variables
# définies sont substituées : les variables nginx ($remote_addr…) restent intactes.

# --- Limitation du débit par IP (relecture de sécurité, M4) -------------------
# Valeurs GÉNÉREUSES : au Sénégal, les opérateurs mobiles placent beaucoup d'abonnés derrière une même
# IP publique (CGNAT). Le but est d'arrêter les robots qui inondent le site, pas un bureau qui navigue.
# Chaque zone : un débit moyen et une rafale (burst) servie sans attente (nodelay).
#  - api       : toutes les routes /api/ appelées par le navigateur ;
#  - recherche : /api/recherche (autocomplétion à chaque frappe, requêtes pg_trgm coûteuses) ;
#  - pages     : pages HTML rendues par le SSR. Le SSR appelle le backend directement, sans repasser par
#                nginx : sans cette zone, des pages de liste aux filtres aléatoires feraient travailler
#                le backend sans aucune limite. Les fichiers statiques (JS, CSS, polices, images) n'y
#                sont pas comptés.
# Au-delà : 429. Si un CDN est placé devant nginx, la clé doit devenir l'IP réelle (module real_ip).
limit_req_zone $binary_remote_addr zone=api:10m rate=${NGINX_DEBIT_API};
limit_req_zone $binary_remote_addr zone=recherche:10m rate=${NGINX_DEBIT_RECHERCHE};
# Pages : les fichiers statiques (JS, CSS, polices, images ; une page en charge plusieurs dizaines, sans
# rendu ni appel au backend) ont une clé vide, et nginx ne compte pas une requête à clé vide.
map $uri $cle_pages {
    ~*\.(?:js|mjs|css|map|woff2?|ttf|png|jpe?g|webp|avif|gif|svg|ico|webmanifest|txt)$  "";
    default  $binary_remote_addr;
}
limit_req_zone $cle_pages zone=pages:10m rate=${NGINX_DEBIT_PAGES};
limit_req_status 429;
limit_req_log_level warn;

# --- Journaux sans jeton secret -----------------------------------------------
# Les adresses de suivi de commande contiennent un jeton secret (/suivi/{jeton}, /api/commandes/suivi/{jeton}/…),
# celles des e-mails de compte aussi (/compte/verifier-email?jeton=…, /compte/nouveau-mot-de-passe?jeton=…,
# /compte/deverrouiller?jeton=…). Quiconque lit un journal d'accès ne doit pas pouvoir s'en servir : le format
# « confidentiel » remplace le jeton par [jeton], supprime les paramètres des pages à jeton et ne garde du Referer
# que le site d'origine (une page à jeton envoie son adresse complète comme Referer aux fichiers qu'elle charge).
# Les mêmes règles sont appliquées aux journaux du backend (noyau/journal/MasqueJetons).
# Ce format est utilisé par TOUS les serveurs (access_log dans chaque bloc server, qui remplace celui de nginx.conf).
map $uri $chemin_journal {
    ~^(?<debut>/suivi/)[^/]+(?<fin>.*)$                   "${debut}[jeton]${fin}";
    ~^(?<debut>/api/commandes/suivi/)[^/]+(?<fin>.*)$     "${debut}[jeton]${fin}";
    default                                               $uri;
}
map "$uri?$args" $args_journal {
    "~^/compte/(?:verifier-email|nouveau-mot-de-passe|deverrouiller)\?"   "";
    "~^/(?:suivi|api/commandes/suivi)/"                                    "";
    "~*[?&;](?:jeton|token)(?:=|&|;|$)"                                    "?[parametres masques]";
    "~\?$"                                                                 "";
    "~\?(?<reste>.+)$"                                                     "?$reste";
}
map $http_referer $referer_journal {
    ~^(?<origine>https?://[^/]+)    $origine;
    default                         "-";
}
log_format confidentiel '$remote_addr [$time_local] "$request_method $chemin_journal$args_journal" '
                        '$status $body_bytes_sent "$referer_journal" "$http_user_agent" rt=$request_time '
                        'amont=$upstream_status';

# Serveurs du mode choisi (HTTPS ou HTTP simple), qui incluent les routes communes
include /etc/nginx/conf.d/mode/serveurs.conf;
